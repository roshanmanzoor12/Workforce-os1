# =========================================================
# APPLICATION
# =========================================================

APP_NAME=WorkforceOS
APP_VERSION=0.1.0

APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8001

WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

API_BASE_URL=http://localhost:8001
API_V1_PREFIX=/api/v1


# =========================================================
# CORS
# =========================================================

CORS_ORIGINS=http://localhost:3001,http://localhost:3002


# =========================================================
# POSTGRESQL - CONTROL DATABASE
# =========================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CONTROL_DATABASE_NAME=workforce_control

CONTROL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workforce_control

POSTGRES_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres


# =========================================================
# TENANT DATABASES
# =========================================================

TENANT_DATABASE_PREFIX=tenant_

TENANT_DATABASE_POOL_SIZE=5
TENANT_DATABASE_MAX_OVERFLOW=10
TENANT_DATABASE_POOL_TIMEOUT=30

TENANT_AUTO_PROVISION=false


# =========================================================
# REDIS
# =========================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

REDIS_KEY_PREFIX=workforceos:


# =========================================================
# JWT / AUTHENTICATION
# =========================================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

JWT_ALGORITHM=HS256

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

EMAIL_VERIFICATION_OTP_MINUTES=10
PASSWORD_RESET_OTP_MINUTES=10

OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5


# =========================================================
# PASSWORD POLICY
# =========================================================

PASSWORD_MIN_LENGTH=8

PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false


# =========================================================
# GOOGLE OAUTH
# =========================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/google/callback


# =========================================================
# GITHUB OAUTH
# =========================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITHUB_REDIRECT_URI=http://localhost:8001/api/v1/auth/github/callback


# =========================================================
# EMAIL / SMTP
# =========================================================

SMTP_HOST=
SMTP_PORT=587

SMTP_USERNAME=officepromotix@gmail.com
SMTP_PASSWORD=vpgwiqzaalsrxidh

SMTP_FROM_EMAIL=noreply@workforceos.local
SMTP_FROM_NAME=WorkforceOS

SMTP_USE_TLS=true

EMAIL_ENABLED=false


# =========================================================
# OBJECT STORAGE / MINIO / S3
# =========================================================

S3_ENDPOINT=http://localhost:9000

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

S3_BUCKET=workforce-os
S3_REGION=us-east-1

S3_USE_SSL=false

S3_PRESIGNED_URL_EXPIRY_SECONDS=900


# =========================================================
# FILE UPLOAD
# =========================================================

MAX_UPLOAD_SIZE_MB=100

ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt

ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp


# =========================================================
# BILLING / STRIPE
# =========================================================

PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# =========================================================
# AI
# =========================================================

OPENAI_API_KEY=

AI_ENABLED=false

AI_DEFAULT_MODEL=


# =========================================================
# WEBSOCKET / REALTIME
# =========================================================

WEBSOCKET_ENABLED=true

WEBSOCKET_HEARTBEAT_SECONDS=30


# =========================================================
# LIVEKIT / VOICE / VIDEO
# =========================================================

LIVEKIT_URL=ws://localhost:7880

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

LIVEKIT_ENABLED=false


# =========================================================
# TURN SERVER
# =========================================================

TURN_SERVER_URL=turn:localhost:3478

TURN_USERNAME=workforce
TURN_PASSWORD=change-me


# =========================================================
# EMPLOYEE MONITORING
# =========================================================

MONITORING_ENABLED=true

MONITORING_REQUIRE_DISCLOSURE=true

MONITORING_DEFAULT_WORK_HOURS_ONLY=true

MONITORING_DEFAULT_IDLE_THRESHOLD_SECONDS=300

MONITORING_DEFAULT_HEARTBEAT_SECONDS=15

MONITORING_DEFAULT_SCREENSHOT_ENABLED=false

MONITORING_DEFAULT_SCREENSHOT_INTERVAL_SECONDS=300


# =========================================================
# PAYROLL DEFAULTS
# =========================================================

DEFAULT_PAYROLL_CURRENCY=PKR

DEFAULT_SHIFT_HOURS_PER_DAY=8

DEFAULT_LATE_GRACE_MINUTES=0

DEFAULT_OVERTIME_MULTIPLIER=1.5


# =========================================================
# ATTENDANCE DEFAULTS
# =========================================================

DEFAULT_ATTENDANCE_MODE=hybrid

DEFAULT_WORK_WEEK=MON,TUE,WED,THU,FRI

DEFAULT_IDLE_THRESHOLD_SECONDS=300


# =========================================================
# LOGGING
# =========================================================

LOG_LEVEL=INFO

LOG_FORMAT=text

LOG_INCLUDE_REQUEST_ID=true


# =========================================================
# SECURITY
# =========================================================

RATE_LIMIT_ENABLED=true

RATE_LIMIT_DEFAULT_REQUESTS=100

RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

TRUST_PROXY_HEADERS=false


# =========================================================
# PLATFORM
# =========================================================

PLATFORM_NAME=WorkforceOS

PLATFORM_SUPPORT_EMAIL=support@workforceos.local

PLATFORM_DEFAULT_TIMEZONE=UTC

PLATFORM_DEFAULT_LOCALE=en-US


# =========================================================
# DEVELOPMENT
# =========================================================

DEV_CREATE_DEFAULT_ADMIN=false

DEV_DEFAULT_ADMIN_EMAIL=roshanmanzoor132@gmail.com

DEV_DEFAULT_ADMIN_PASSWORD=1qazZAQ!