from __future__ import annotations

import uuid

from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from .enums import BillingProvider, SubscriptionStatus
from .models import BillingCustomer, BillingSubscription
from .plans import PlanCode


class BillingRepository:
    async def get_customer_for_user(
        self,
        session: AsyncSession,
        *,
        user_id: uuid.UUID,
    ) -> BillingCustomer | None:
        statement = select(
            BillingCustomer
        ).where(
            BillingCustomer.user_id
            == user_id
        )

        result = await session.execute(
            statement
        )

        return result.scalar_one_or_none()

    async def get_subscription_for_user(
        self,
        session: AsyncSession,
        *,
        user_id: uuid.UUID,
    ) -> BillingSubscription | None:
        statement = select(
            BillingSubscription
        ).where(
            BillingSubscription.user_id
            == user_id
        )

        result = await session.execute(
            statement
        )

        return result.scalar_one_or_none()

    async def ensure_customer(
        self,
        session: AsyncSession,
        *,
        user_id: uuid.UUID,
        provider: BillingProvider = BillingProvider.NONE,
        provider_customer_id: str | None = None,
    ) -> BillingCustomer:
        existing = await self.get_customer_for_user(
            session,
            user_id=user_id,
        )

        if existing is not None:
            return existing

        customer = BillingCustomer(
            user_id=user_id,
            provider=provider,
            provider_customer_id=provider_customer_id,
        )

        session.add(
            customer
        )

        await session.flush()

        return customer

    async def ensure_subscription(
        self,
        session: AsyncSession,
        *,
        user_id: uuid.UUID,
    ) -> BillingSubscription:
        existing = await self.get_subscription_for_user(
            session,
            user_id=user_id,
        )

        if existing is not None:
            return existing

        subscription = BillingSubscription(
            user_id=user_id,
            plan_code=PlanCode.FREE,
            provider=BillingProvider.NONE,
            status=SubscriptionStatus.NONE,
        )

        session.add(
            subscription
        )

        await session.flush()

        return subscription

    async def update_subscription(
        self,
        session: AsyncSession,
        *,
        subscription: BillingSubscription,
        plan_code: PlanCode,
        provider: BillingProvider,
        provider_subscription_id: str | None,
        status: SubscriptionStatus,
    ) -> BillingSubscription:
        subscription.plan_code = (
            plan_code
        )

        subscription.provider = (
            provider
        )

        subscription.provider_subscription_id = (
            provider_subscription_id
        )

        subscription.status = (
            status
        )

        await session.flush()

        return subscription

    async def count_subscriptions(
        self,
        session: AsyncSession,
    ) -> int:
        statement = select(
            func.count(
                BillingSubscription.id
            )
        )

        result = await session.execute(
            statement
        )

        return int(
            result.scalar_one()
        )