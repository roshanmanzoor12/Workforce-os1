from __future__ import annotations

import uuid
from typing import (
    Annotated,
    Any,
)

from fastapi import (
    APIRouter,
    Depends,
    HTTPException,
    Query,
    status,
)

from app.core.exceptions import (
    ValidationError,
)
from app.modules.live_monitoring.access import (
    resolve_live_monitoring_access,
)
from app.modules.live_monitoring.schemas import (
    LiveMonitoringCapabilitiesResponse,
    LiveScreenActivateRequest,
    LiveScreenDecision,
    LiveScreenEndRequest,
    LiveScreenRequestCreate,
    LiveScreenResponse,
    ScreenshotAgentComplete,
    ScreenshotAgentDeny,
    ScreenshotListResponse,
    ScreenshotRequestCreate,
    ScreenshotResponse,
)
from app.modules.live_monitoring.service import (
    LiveMonitoringNotFoundError,
    LiveMonitoringPermissionError,
    LiveMonitoringService,
)
from app.modules.tenant_api.dependencies import (
    get_authorized_tenant_context,
)


router = APIRouter(
    prefix=(
        "/workspaces/"
        "{workspace_id}/live-monitoring"
    ),
    tags=[
        "live-monitoring",
    ],
)


TenantContext = Annotated[
    Any,
    Depends(
        get_authorized_tenant_context
    ),
]


async def _access(
    *,
    workspace_id: uuid.UUID,
    context: Any,
):
    return await (
        resolve_live_monitoring_access(
            workspace_id=workspace_id,
            context=context,
        )
    )


def _service(
    context: Any,
) -> LiveMonitoringService:
    return LiveMonitoringService(
        context.tenant_session
    )


def _http_error(
    exc: Exception,
) -> HTTPException:
    if isinstance(
        exc,
        LiveMonitoringNotFoundError,
    ):
        return HTTPException(
            status_code=404,
            detail=str(
                exc
            ),
        )

    if isinstance(
        exc,
        LiveMonitoringPermissionError,
    ):
        return HTTPException(
            status_code=403,
            detail=str(
                exc
            ),
        )

    if isinstance(
        exc,
        ValidationError,
    ):
        return HTTPException(
            status_code=422,
            detail=str(
                exc
            ),
        )

    raise exc


@router.post(
    "/screenshots",
    response_model=ScreenshotResponse,
)
async def request_screenshot(
    workspace_id: uuid.UUID,
    payload: ScreenshotRequestCreate,
    context: TenantContext,
) -> ScreenshotResponse:
    access = await _access(
        workspace_id=workspace_id,
        context=context,
    )

    try:
        return await (
            _service(
                context
            )
            .request_screenshot(
                access=access,
                payload=payload,
            )
        )

    except (
        ValidationError,
        LiveMonitoringNotFoundError,
        LiveMonitoringPermissionError,
    ) as exc:
        raise _http_error(
            exc
        ) from exc


